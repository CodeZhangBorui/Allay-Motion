{
  "name": "allay-motion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @allay/desktop dev",
    "build": "pnpm --filter @allay/desktop build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --workspace-concurrency=4 typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:engine": "tsx scripts/not-implemented.ts test:engine M1",
    "test:export": "tsx scripts/not-implemented.ts test:export M1",
    "test:e2e": "pnpm build && playwright test",
    "check:provenance": "tsx scripts/check-provenance.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:engine && pnpm test:export && pnpm check:provenance && pnpm check:licenses && pnpm test:e2e",
    "assets:gen": "tsx scripts/not-implemented.ts assets:gen M2",
    "templates:build": "tsx scripts/not-implemented.ts templates:build M3",
    "mascot:bake": "tsx scripts/not-implemented.ts mascot:bake M5",
    "ffmpeg:fetch": "tsx scripts/not-implemented.ts ffmpeg:fetch M1",
    "dist": "pnpm --filter @allay/desktop dist && vitest run --config vitest.dist.config.ts"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "picomatch": "^4.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
